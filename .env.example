# ─── Gmail SMTP (Nodemailer) ───────────────────────────────────────────────
# SMTP_USER is the Gmail account that SENDS mail (needs a Google App Password).
# NOTIFICATION_RECEIVER_EMAIL is where new quotes/enquiries are delivered.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-account@gmail.com
SMTP_PASS=your-google-app-password
NOTIFICATION_RECEIVER_EMAIL=admin@prolinkconsultancy.in

# ─── Cloudinary (tech-pack / attachment uploads) ───────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
